# .env.example
APP_NAME=SemDatasheet
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

RAW_DATA_DIR=./data/raw
ARTIFACTS_DIR=./artifacts

CHUNK_SIZE=300
CHUNK_OVERLAP=50
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
ALLOW_MODEL_DOWNLOAD=false
HYBRID_ALPHA=0.65
DEFAULT_TOP_K=3
MAX_TOP_K=10
LOG_LEVEL=INFO

MLFLOW_TRACKING_URI=file://./artifacts/mlruns
MLFLOW_EXPERIMENT_NAME=SemDatasheet